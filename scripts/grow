#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if command -v uv >/dev/null 2>&1; then
  exec uv run --project "$REPO_ROOT" grow "$@"
elif [ -x "$REPO_ROOT/.venv/bin/grow" ]; then
  exec "$REPO_ROOT/.venv/bin/grow" "$@"
else
  echo "Error: neither 'uv' nor '$REPO_ROOT/.venv/bin/grow' was found." >&2
  exit 1
fi
